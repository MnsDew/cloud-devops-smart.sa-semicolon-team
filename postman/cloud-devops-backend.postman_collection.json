{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Cloud DevOps Backend",
    "description": "Importable Postman collection for cloud-devops-backend.\n\n**Auth:** None — this API has no authentication. Do not send Authorization headers.\n\n**Base URL:** Set `baseUrl` collection variable (default `http://localhost:3000`).\n\n**Flow tip:** Run Create Task (success) first — it saves `taskId` for Get / Update / Delete requests.\n\n**Task status values:** `TODO` | `IN_PROGRESS` | `DONE`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Liveness and readiness probes. No body. No auth.",
      "item": [
        {
          "name": "Liveness — GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "**Auth:** none\n**Body:** none\n**Expected:** `200` `{ status: \"ok\", service, timestamp }`"
          },
          "response": []
        },
        {
          "name": "Readiness — GET /health/ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "**Auth:** none\n**Body:** none\n**Expected:** `200` when DB is up; `503` when DB is down"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks — Happy path",
      "description": "CRUD success cases. Create saves `taskId` for the rest.",
      "item": [
        {
          "name": "Create Task — minimal (title only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('taskId', json.data.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ship MVP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tasks",
            "description": "**Auth:** none\n**Where:** Body (JSON)\n\n| Field | Required | Notes |\n|-------|----------|-------|\n| title | yes | string, trim, 1–200 chars |\n| description | no | string, max 5000, or null |\n| status | no | `TODO` (default) / `IN_PROGRESS` / `DONE` |\n\n**Expected:** `201` `{ data: task }` — script saves `taskId`"
          },
          "response": []
        },
        {
          "name": "Create Task — full body",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('taskId', json.data.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deliver first milestone\",\n  \"description\": \"Write docs, tests, and deploy pipeline\",\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tasks",
            "description": "**Auth:** none\n**Where:** Body (JSON) — all allowed create fields\n**Expected:** `201`"
          },
          "response": []
        },
        {
          "name": "List Tasks — default",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks",
            "description": "**Auth:** none\n**Where:** Query (optional)\n\nDefaults: `page=1`, `limit=20`\n\n**Expected:** `200` `{ data: [], meta: { page, limit, total, totalPages } }`"
          },
          "response": []
        },
        {
          "name": "List Tasks — pagination + status filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?page=1&limit=2&status=TODO",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "integer ≥ 1 (default 1)"
                },
                {
                  "key": "limit",
                  "value": "2",
                  "description": "integer 1–100 (default 20)"
                },
                {
                  "key": "status",
                  "value": "TODO",
                  "description": "optional: TODO | IN_PROGRESS | DONE"
                }
              ]
            },
            "description": "**Auth:** none\n**Where:** Query params (not body)\n**Expected:** `200`"
          },
          "response": []
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
            "description": "**Auth:** none\n**Where:** Path param `id` (UUID)\n\nUses collection variable `{{taskId}}` from Create Task.\n\n**Expected:** `200` `{ data: task }`"
          },
          "response": []
        },
        {
          "name": "Update Task — status only",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
            "description": "**Auth:** none\n**Where:** Path `id` (UUID) + Body (JSON)\n\nAt least one of: `title`, `description`, `status`\n\n**Expected:** `200` `{ data: task }`"
          },
          "response": []
        },
        {
          "name": "Update Task — all fields",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ship MVP (updated)\",\n  \"description\": \"Almost done\",\n  \"status\": \"DONE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
            "description": "**Auth:** none\n**Where:** Path + Body\n**Expected:** `200`"
          },
          "response": []
        },
        {
          "name": "Update Task — clear description (null)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
            "description": "**Auth:** none\n**Where:** Body — `description` may be `null` to clear it\n**Expected:** `200`"
          },
          "response": []
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
            "description": "**Auth:** none\n**Where:** Path param `id` (UUID)\n**Body:** none\n**Expected:** `204` empty body"
          },
          "response": []
        }
      ]
    },
